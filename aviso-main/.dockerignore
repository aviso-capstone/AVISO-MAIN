# Version control
.git
.gitignore
.gitattributes

# Rebuilt inside the image
node_modules
vendor
public/build
public/hot

# Secrets: provided as App Platform env vars, never baked into the image
.env
.env.*
!.env.example

# Runtime data
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/app/*
bootstrap/cache/*.php

# Dev only
tests
phpunit.xml
.phpunit.result.cache
docker-compose.yml
.idea
.vscode
.claude
*.swp
Thumbs.db
.DS_Store
